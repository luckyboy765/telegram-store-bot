# ====== TELEGRAM ======
BOT_TOKEN=123456:ganti_dengan_token_dari_botfather
# ID admin (boleh lebih dari satu, pisahkan koma). Cek pakai @userinfobot
ADMIN_IDS=123456789

# ====== TOKO ======
STORE_NAME=AUTOPAY STORE
PRODUCTS_PER_PAGE=5
# Berapa menit invoice QRIS berlaku sebelum kedaluwarsa
INVOICE_EXPIRE_MINUTES=15

# ====== TRIPAY (payment gateway QRIS) ======
# Daftar merchant di https://tripay.co.id  -> ambil dari menu Merchant
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# true = pakai server sandbox (testing), false = production
TRIPAY_SANDBOX=true
# Kode channel pembayaran. QRIS = "QRIS" (atau "QRISC" utuk beberapa merchant)
TRIPAY_CHANNEL=QRIS

# ====== WEBHOOK (opsional, buat callback otomatis dari Tripay) ======
# Kalau diisi, bot buka web server buat nerima callback.
# Kalau dikosongin, bot pakai POLLING status ke Tripay (tetap otomatis, tanpa buka port).
WEBHOOK_HOST=
WEBHOOK_PORT=8080
